{
	"name": "df_dvh_ansatt",
	"properties": {
		"folder": {
			"name": "tidreg"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_ansatt",
						"type": "DatasetReference"
					},
					"name": "STGansatt"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ansatt",
						"type": "DatasetReference"
					},
					"name": "DVHansatt"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ansatt_id as string,",
				"          ansattnr as string,",
				"          fornavn as string,",
				"          etternavn as string,",
				"          epost as string,",
				"          stillingstittel as string,",
				"          stillingsprosent as string,",
				"          ansatt_dato as string,",
				"          slutt_dato as string,",
				"          naermeste_leder_id as string,",
				"          opprettet_tid as string,",
				"          endret_tid as string,",
				"          endret_av as string,",
				"          load_ts as timestamp,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> STGansatt",
				"STGansatt derive(ansatt_id = toInteger(ansatt_id),",
				"          ansatt_dato = toDate(ansatt_dato, 'yyyy-mm-dd'),",
				"          slutt_dato = toDate(slutt_dato, 'yyyy-mm-dd'),",
				"          naermeste_leder_id = toInteger(naermeste_leder_id),",
				"          opprettet_tid = toTimestamp(opprettet_tid, 'YYYY-MM-DD HH:MM:SS'),",
				"          endret_tid = toTimestamp(endret_tid, 'YYYY-MM-DD HH:MM:SS'),",
				"          load_ts = ERROR_FUNCTION('toTimestamp(opprettet_tid, __SINGLE_QUOTE__YYYY-MM-DD HH:MM:SS__SINGLE_QUOTE__)load_ts')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ansatt_id as integer,",
				"          ansattnr as string,",
				"          fornavn as string,",
				"          etternavn as string,",
				"          epost as string,",
				"          stillingstittel as string,",
				"          stillingsprosent as decimal(5,2),",
				"          ansatt_dato as date,",
				"          slutt_dato as date,",
				"          naermeste_leder_id as integer,",
				"          opprettet_tid as timestamp,",
				"          endret_tid as timestamp,",
				"          endret_av as string,",
				"          stg_load_ts as timestamp,",
				"          source_file as string,",
				"          dvh_load_ts as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> DVHansatt"
			]
		}
	}
}