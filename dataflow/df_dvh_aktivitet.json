{
	"name": "df_dvh_aktivitet",
	"properties": {
		"description": "read from stg to dvh integration",
		"folder": {
			"name": "tidreg"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "STGaktivitet"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Aktivitet",
						"type": "DatasetReference"
					},
					"name": "DVHaktivitet",
					"description": "aktivitet"
				}
			],
			"transformations": [
				{
					"name": "EXP"
				}
			],
			"scriptLines": [
				"source(output(",
				"          aktivitet_id as string,",
				"          prosjekt_id as string,",
				"          aktivitetskode as string,",
				"          aktivitetsnavn as string,",
				"          aktiv as string,",
				"          opprettet_tid as string,",
				"          load_ts as timestamp,",
				"          source_file as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> STGaktivitet",
				"STGaktivitet derive(aktivitetsnavn = upper(aktivitetsnavn),",
				"          aktivitet_id = toInteger(aktivitet_id),",
				"          prosjekt_id = toInteger(prosjekt_id),",
				"          aktiv = iif(aktiv == 'J', true(), false()),",
				"          opprettet_tid = toDate(opprettet_tid, 'yyyy-MM-dd')) ~> EXP",
				"EXP sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          aktivitet_id,",
				"          prosjekt_id,",
				"          aktivitetskode,",
				"          aktivitetsnavn,",
				"          aktiv,",
				"          opprettet_tid,",
				"          stg_load_ts = load_ts,",
				"          source_file",
				"     )) ~> DVHaktivitet"
			]
		}
	}
}